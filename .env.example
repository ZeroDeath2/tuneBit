# Supabase — use current Supabase env var naming conventions
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only — NEVER expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# SoundCloud API — server-only
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=

# Production domain — used for OAuth redirects, share links, OG tags
NEXT_PUBLIC_APP_URL=https://tunebit.zeusserver.in

# Admin access — comma-separated list of Google OAuth emails
ADMIN_EMAILS=
